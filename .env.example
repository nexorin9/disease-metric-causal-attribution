# =============================================================================
# 单病种指标因果归因系统 — 凭据与运行时配置（环境变量样板）
# =============================================================================
# 部署前 cp .env.example .env 并填入真实凭据；.env 已在 .gitignore 中屏蔽，
# 不得提交真实凭据到仓库。本文件所有键都是 spec.md §8 列出的凭据位。
# =============================================================================

# ---------- 应用基础 ----------
APP_ENV=local                              # local / staging / prod
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO                         # DEBUG / WARNING / INFO / ERROR

# ---------- 项目自带 PostgreSQL（草稿 + 审计日志） ----------
# 真实部署用 postgresql+psycopg2://user:pass@host:5432/dbname
# 本地端到端可用 SQLite 替身：sqlite:///./local_state.db（生产环境禁止）
DATABASE_URL=sqlite:///./local_state.db

# ---------- HIS 出院病案首页库直连（只读） ----------
# 真实格式：
#   HIS_DB_URL=postgresql+psycopg2://his_user:his_pass@10.0.0.5:5432/his_discharge
#   HIS_DB_URL=mysql+pymysql://his_user:his_pass@10.0.0.5:3306/his_discharge
# 仅读不写；启动时校验必填字段，缺失显式 ValueError 不静默
HIS_DB_URL=postgresql://his_user:CHANGE_ME@127.0.0.1:5432/his_discharge
HIS_DB_USER=his_user
HIS_DB_PASS=CHANGE_ME

# 连接池回收（秒）
HIS_DB_POOL_RECYCLE=1800

# ---------- 单病种上报系统（HTTP POST 写归因报告草稿） ----------
# 仅 reviewer 在面板点「确认」才触发；retry 3 次（指数退避）；失败回退 pending_review + 审计
DIPCASE_REPORTER_URL=https://dipcase.example-hospital.cn/api/v1
DIPCASE_REPORTER_TOKEN=CHANGE_ME_BEARER_TOKEN
DIPCASE_REPORTER_TIMEOUT=15

# ---------- ModelGateway · OpenAI-compatible 单协议 ----------
# 单一协议；业务层不耦合厂商 SDK
# base_url 不带尾斜杠；model 由平台规定
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=sk-CHANGE_ME
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30                            # 默认上限；推理类内部按 10s / 解释类按 30s 进一步收紧

# 协议替身（仅用于本地协议兼容性测试；产品代码不改 base_url）
# OPENAI_STUB_URL=http://127.0.0.1:18888

# ---------- 业务门栏 ----------
MIN_SAMPLE_SIZE=30                           # n<30 显式标样本不足，禁止写回上报
MAX_CI_WIDTH=0.6                             # CI 上界-下界 > 0.6 标 refutation_unstable
REFUTATION_N_JOBS=-1                         # -1 = 全核并行；测试可改 1

# ---------- 审计 ----------
# 即使 patient_name/id_card/phone 出现在外部输入中，写入 audit_logs 也会被 strip_pii 剔除
AUDIT_LOG_RETENTION_DAYS=365

# ---------- 面板鉴权 ----------
# 单点接入默认；多租户场景可在 Phase 4 后续 task 扩展 JWT
QUALITY_ROLE_HEADER=X-Quality-Role
# 启动时给的本地 reviewer（演示 / 开发用；生产对接院内 SSO）
LOCAL_REVIEWER_ID=dev-reviewer-001
LOCAL_REVIEWER_ROLE=med_committee_reviewer